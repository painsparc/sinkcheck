  "sinks": [
    {
      "id": "core.fsmonitor",
      "key": "core.fsmonitor",
      "tier": "A",
      "match": "bool_or_command",
      "severity": "critical",
      "safe_values": [
        "false",
        "no",
        "off",
        ""
      ],
      "sweep": [
        "fsmonitor"
      ],
      "protections": "none",
      "triggers": "Git runs the named command whenever it refreshes the index, to learn which files changed. It fires even when the pathspec given does not exist.",
      "reached_by": [
        "status",
        "diff",
        "add",
        "commit",
        "checkout",
        "rm --cached",
        "ls-files",
        "any index refresh"
      ],
      "evidence": [
        {
          "origin": "justinsteven-2022",
          "note": "Documents the trigger and the list of operations."
        },
        {
          "origin": "cisco-talos-2025-2243",
          "note": "Independent report of the same mechanism in a scanner tool."
        },
        {
          "origin": "github-copilot-cli-advisory",
          "note": "Agent-specific advisory."
        },
        {
          "origin": "cymulate-claude-code",
          "note": "Agent-specific finding."
        },
        {
          "origin": "code-context-mcp-251",
          "note": "Notes it fires on ls-files and that safe.directory does not help."
        }
      ]
    },
    {
      "id": "core.hookspath",
      "key": "core.hooksPath",
      "tier": "A",
      "match": "command_string",
      "severity": "critical",
      "safe_values": [
        "/dev/null",
        "nul"
      ],
      "sweep": [
        "hookspath"
      ],
      "protections": "none",
      "triggers": "Redirects hook lookup to any directory the repository controls, so hooks need not live inside .git/hooks. Executable files there run on hook-firing operations. A post-index-change hook ran when git status rewrote the index, which it does in a freshly unpacked tree; it does not fire on every git status.",
      "reached_by": [
        "commit",
        "checkout",
        "merge",
        "rebase",
        "push",
        "git status, when it rewrites the index (as in a freshly unpacked tree)",
        "other hook-firing operations"
      ],
      "evidence": [
        {
          "origin": "github-copilot-cli-advisory",
          "note": "Named as an executable config key."
        },
        {
          "origin": "bound-agents-issue-171",
          "note": "Listed among exec-surface directives."
        },
        {
          "origin": "gitpython-safe-mode",
          "note": "Overridden in GitPython's safe mode."
        },
        {
          "origin": "code-context-mcp-251",
          "note": "Overridden on every git call."
        }
      ]
    },
    {
      "id": "filter.clean",
      "key": "filter.*.clean",
      "tier": "A",
      "match": "command_string",
      "severity": "critical",
      "attribute": "filter",
      "sweep": [],
      "protections": "none",
      "triggers": "Runs when git adds, diffs, or compares content for status on a path whose attributes name this filter driver. The attributes can come from a .gitattributes file in the same untrusted tree, .git/info/attributes, a file named by core.attributesFile, or a tree named by attr.tree.",
      "reached_by": [
        "add",
        "diff",
        "status (content comparison)",
        "commit"
      ],
      "evidence": [
        {
          "origin": "hermes-agent-changelog",
          "note": "Hermes fixed automatic git calls running clean/smudge/process filters from an untrusted repo's config before the first prompt."
        }
      ],
      "host_benign_values": [
        "git-lfs clean -- %f"
      ]
    },
    {
      "id": "filter.smudge",
      "key": "filter.*.smudge",
      "tier": "A",
      "match": "command_string",
      "severity": "critical",
      "attribute": "filter",
      "sweep": [
        "smudge"
      ],
      "protections": "none",
      "triggers": "Runs when git checks out a path whose attributes name this filter driver.",
      "reached_by": [
        "checkout",
        "switch",
        "restore",
        "clone",
        "worktree add"
      ],
      "evidence": [
        {
          "origin": "hermes-agent-changelog",
          "note": "Same Hermes finding as filter.clean."
        }
      ],
      "host_benign_values": [
        "git-lfs smudge -- %f",
        "git-lfs smudge --skip -- %f"
      ]
    },
    {
      "id": "filter.process",
      "key": "filter.*.process",
      "tier": "A",
      "match": "command_string",
      "severity": "critical",
      "attribute": "filter",
      "sweep": [],
