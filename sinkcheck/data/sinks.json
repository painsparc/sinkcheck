{
  "schema_version": 1,
  "ruleset_version": 2,
  "ruleset_date": "2026-10-29",
  "description": "Git configuration keys that can cause command execution. This file is data: adding a sink is a data change. Evidence 'origin' ids resolve in 'origins'. A rule backed by fewer than two independent origins is reported as single-source or unverified; the engine computes this, it is never hand-set. The list is not exhaustive and git's maintainers have said an exhaustive list is not achievable.",
  "matchers": {
    "command_string": "Any non-empty value is a command or path git may execute.",
    "bool_or_command": "Git boolean words and plain integers are not commands; any other value is treated as a command.",
    "bang_prefix": "Only a value starting with '!' runs a shell command.",
    "ext_url": "Only a value starting with 'ext::' runs a command.",
    "value_in": "Only the values listed in hit_values are hits.",
    "any_value": "Presence of the key is the finding.",
    "include": "Structural: pulls in another file. Followed by the engine where supported."
  },
  "protections": {
    "none": {
      "safe_directory": "Does not apply. It rejects repositories owned by a different user; an unpacked archive is owned by you.",
      "protocol": "Does not apply. protocol.*.allow governs transport protocols only.",
      "note": "Git has no switch that disables repo-local execution settings in a repository you own."
    },
    "protocol_ext": {
      "safe_directory": "Does not apply.",
      "protocol": "Relevant to ext:: transports only; protocol.ext.allow is itself readable from repo-local config.",
      "note": ""
    },
    "protected_scope": {
      "safe_directory": "Not the relevant control.",
      "protocol": "Not the relevant control.",
      "note": "Git ignores this variable when it is read from repo-local config (protected-configuration-only). Reported for completeness."
    }
  },
