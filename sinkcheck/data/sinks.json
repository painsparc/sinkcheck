    {
      "id": "attr.tree",
      "key": "attr.tree",
      "tier": "C",
      "match": "any_value",
      "severity": "review",
      "sweep": [],
      "protections": "none",
      "triggers": "Reads gitattributes from a tree object named in config instead of the working tree, so it can select a filter, diff or merge driver for any path without a .gitattributes file. sinkcheck does not read git objects, so the attributes this tree carries are not known.",
      "reached_by": [
        "add",
        "diff",
        "status (content comparison)",
        "checkout"
      ],
      "evidence": [
        {
          "origin": "cve-2026-19593",
          "note": "attr.tree plus a configured clean or process filter ran an attacker program when Codex Desktop inspected a workspace."
        }
      ]
    },
    {
      "id": "core.attributesfile",
      "key": "core.attributesFile",
      "tier": "C",
      "match": "any_value",
      "severity": "review",
      "sweep": [
        "attributesfile"
      ],
      "protections": "none",
      "triggers": "Names an extra gitattributes file. Set in repository config, it can select a filter, diff or merge driver for any path from a file outside the usual places. A file inside the target is read and paired with drivers; one outside it is not read.",
      "reached_by": [
